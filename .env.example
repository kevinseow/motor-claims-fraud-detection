# Gemini API / OpenAI-compatible configuration
FRAUD_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
FRAUD_API_KEY=your_gemini_api_key_here
FRAUD_API_FLAVOR=openai
FRAUD_RPM=5

# Automatic multi-model fallback chains (comma-separated)
FRAUD_VISION_CHAIN=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
FRAUD_TEXT_CHAIN=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# Cloud Run Web UI configuration (if self-hosting)
# AUTH_ENABLED=false               # Set to "false" for public mode, "true" to require UI_API_KEY
# UI_API_KEY=your_ui_access_key    # Required only when AUTH_ENABLED=true
# GCS_BUCKET=your_storage_bucket_name
# GCP_PROJECT=your_project_id
# GCP_REGION=asia-southeast1
# FRAUD_RUN_JOB=fraud-detection-job
